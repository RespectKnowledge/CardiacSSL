"""Masked autoencoding for 3D medical images.

FM-Bench keeps the SSL objective separate from the backbone while allowing
architecture-appropriate reconstruction networks.

The CNN implementation reproduces the ResEncL MAE setup used by nnSSL:
75% block masking, zero-valued masked voxels, a ResidualEncoderUNet
reconstruction network, and MSE evaluated only over masked voxels.
"""

from __future__ import annotations

from dataclasses import dataclass
from math import prod

import torch
from torch import nn

from dynamic_network_architectures.architectures.unet import ResidualEncoderUNet

from fmbench.backbones.cnn3d import CNN3D


@dataclass
class MAEConfig:
    """Configuration shared by FM-Bench MAE implementations."""

    mask_ratio: float = 0.75
    mask_block_size: int = 16

    def __post_init__(self) -> None:
        if not 0.0 < self.mask_ratio < 1.0:
            raise ValueError("mask_ratio must be between 0 and 1.")

        if self.mask_block_size <= 0:
            raise ValueError("mask_block_size must be positive.")


def create_block_mask(
    spatial_shape: tuple[int, int, int],
    block_size: int = 16,
    mask_ratio: float = 0.75,
    *,
    device: torch.device | str | None = None,
    generator: torch.Generator | None = None,
) -> torch.Tensor:
    """Create the low-resolution binary mask used by the original CNN MAE.

    Returns
    -------
    torch.Tensor
        Shape ``(D/block, H/block, W/block)``.

        ``1`` means visible and ``0`` means masked.
    """

    if len(spatial_shape) != 3:
        raise ValueError("spatial_shape must contain exactly three dimensions.")

    if block_size <= 0:
        raise ValueError("block_size must be positive.")

    if not 0.0 <= mask_ratio <= 1.0:
        raise ValueError("mask_ratio must be between 0 and 1.")

    if any(size < block_size for size in spatial_shape):
        raise ValueError(
            "Every spatial dimension must be at least as large as block_size."
        )

    if any(size % block_size != 0 for size in spatial_shape):
        raise ValueError(
            "Every spatial dimension must be divisible by block_size."
        )

    low_shape = tuple(size // block_size for size in spatial_shape)
    n_blocks = prod(low_shape)
    n_masked = int(mask_ratio * n_blocks)

    flat_mask = torch.ones(
        n_blocks,
        dtype=torch.float32,
        device=device,
    )

    indices = torch.randperm(
        n_blocks,
        generator=generator,
        device=device,
    )[:n_masked]

    flat_mask[indices] = 0.0

    return flat_mask.reshape(low_shape)


def create_voxel_mask(
    batch_size: int,
    spatial_shape: tuple[int, int, int],
    block_size: int = 16,
    mask_ratio: float = 0.75,
    *,
    device: torch.device | str | None = None,
    generator: torch.Generator | None = None,
) -> torch.Tensor:
    """Create a full-resolution MAE mask.

    Output shape is ``(B, 1, D, H, W)``.
    ``1`` denotes visible voxels and ``0`` denotes masked voxels.
    """

    if batch_size <= 0:
        raise ValueError("batch_size must be positive.")

    masks = [
        create_block_mask(
            spatial_shape,
            block_size,
            mask_ratio,
            device=device,
            generator=generator,
        )
        for _ in range(batch_size)
    ]

    mask = torch.stack(masks, dim=0).unsqueeze(1)

    mask = mask.repeat_interleave(block_size, dim=2)
    mask = mask.repeat_interleave(block_size, dim=3)
    mask = mask.repeat_interleave(block_size, dim=4)

    return mask


class MaskedMSELoss(nn.Module):
    """MSE over masked voxels only.

    Mask convention follows nnSSL:
    ``1 = visible`` and ``0 = masked``.
    """

    def forward(
        self,
        reconstruction: torch.Tensor,
        target: torch.Tensor,
        mask: torch.Tensor,
    ) -> torch.Tensor:
        if reconstruction.shape != target.shape:
            raise ValueError(
                "reconstruction and target must have identical shapes."
            )

        if mask.shape != target.shape and not (
            mask.ndim == target.ndim
            and mask.shape[0] == target.shape[0]
            and mask.shape[1] == 1
            and mask.shape[2:] == target.shape[2:]
        ):
            raise ValueError(
                "mask must match target spatial dimensions and batch size."
            )

        masked = 1.0 - mask
        denominator = masked.expand_as(target).sum()

        if denominator.item() == 0:
            raise ValueError("The mask contains no masked voxels.")

        squared_error = (reconstruction - target) ** 2

        return (
            squared_error * masked
        ).sum() / denominator


class CNNMAE(nn.Module):
    """ResEncL masked autoencoder.

    The encoder configuration is taken directly from ``CNN3D`` and the
    decoder reproduces the historical ResEncL decoder structure.
    """

    def __init__(
        self,
        backbone: CNN3D,
        config: MAEConfig | None = None,
    ) -> None:
        super().__init__()

        if not isinstance(backbone, CNN3D):
            raise TypeError("CNNMAE requires a CNN3D backbone.")

        self.config = config or MAEConfig()
        self.backbone = backbone

        n_stages = len(backbone.features_per_stage)

        self.network = ResidualEncoderUNet(
            input_channels=backbone.in_channels,
            n_stages=n_stages,
            features_per_stage=list(backbone.features_per_stage),
            conv_op=nn.Conv3d,
            kernel_sizes=[
                [3, 3, 3]
                for _ in range(n_stages)
            ],
            strides=[
                [s, s, s]
                for s in backbone.strides
            ],
            n_blocks_per_stage=list(backbone.blocks_per_stage),
            num_classes=backbone.in_channels,
            n_conv_per_stage_decoder=[
                1 for _ in range(n_stages - 1)
            ],
            conv_bias=True,
            norm_op=nn.InstanceNorm3d,
            norm_op_kwargs={
                "eps": 1e-5,
                "affine": True,
            },
            nonlin=nn.LeakyReLU,
            nonlin_kwargs={
                "inplace": True,
            },
            deep_supervision=False,
        )

        # Reuse one shared encoder throughout the MAE.
        # ResidualEncoderUNet constructs its decoder with a reference to its
        # original encoder, so both references must be replaced.
        self.network.encoder = self.backbone.encoder
        self.network.decoder.encoder = self.backbone.encoder

        # Deep supervision is disabled, so only the final segmentation
        # layer produces the reconstruction. Exclude the unused auxiliary
        # output heads from optimization/DDP.
        for layer in self.network.decoder.seg_layers[:-1]:
            layer.requires_grad_(False)

        self.loss_fn = MaskedMSELoss()

    @property
    def feature_dim(self) -> int:
        return self.backbone.feature_dim

    def reconstruct(
        self,
        x: torch.Tensor,
        mask: torch.Tensor,
    ) -> torch.Tensor:
        return self.network(x * mask)

    def compute_loss(
        self,
        x: torch.Tensor,
        *,
        generator: torch.Generator | None = None,
    ) -> dict[str, torch.Tensor]:
        if x.ndim != 5:
            raise ValueError("Expected input shape (B, C, D, H, W).")

        spatial_shape = tuple(int(v) for v in x.shape[2:])

        mask = create_voxel_mask(
            batch_size=x.shape[0],
            spatial_shape=spatial_shape,
            block_size=self.config.mask_block_size,
            mask_ratio=self.config.mask_ratio,
            device=x.device,
            generator=generator,
        )

        reconstruction = self.reconstruct(x, mask)
        loss = self.loss_fn(
            reconstruction,
            x,
            mask,
        )

        return {
            "loss": loss,
            "reconstruction": reconstruction,
            "mask": mask,
        }

    def forward(
        self,
        batch: dict[str, torch.Tensor] | torch.Tensor,
    ) -> dict[str, torch.Tensor]:
        if isinstance(batch, torch.Tensor):
            x = batch
        elif isinstance(batch, dict):
            if "data" not in batch:
                raise KeyError("MAE batch must contain 'data'.")
            x = batch["data"]
        else:
            raise TypeError("batch must be a tensor or dictionary.")

        return self.compute_loss(x)


# ---------------------------------------------------------------------
# EVA / ViT-3D MAE
# ---------------------------------------------------------------------

from einops import rearrange
from dynamic_network_architectures.building_blocks.eva import Eva
from dynamic_network_architectures.building_blocks.patch_encode_decode import (
    PatchDecode,
    LayerNormNd,
)
from dynamic_network_architectures.initialization.weight_init import InitWeights_He
from timm.layers import RotaryEmbeddingCat

from fmbench.backbones.vit3d import ViT3D


@dataclass
class ViTMAEConfig(MAEConfig):
    """EVA-MAE decoder configuration."""

    decoder_depth: int = 2
    decoder_num_heads: int = 12


class ViTMAE(nn.Module):
    """Masked autoencoder for the EVA-based ViT3D backbone.

    MAE owns the patch masking rather than relying on PatchDropout.
    This allows identical masking semantics during training and validation
    while keeping the reusable ViT3D backbone independent of the SSL method.
    """

    def __init__(
        self,
        backbone: ViT3D,
        config: ViTMAEConfig | None = None,
    ) -> None:
        super().__init__()

        if not isinstance(backbone, ViT3D):
            raise TypeError("ViTMAE requires a ViT3D backbone.")

        self.backbone = backbone
        self.config = config or ViTMAEConfig()

        if backbone.config.num_register_tokens != 0:
            raise ValueError(
                "ViTMAE currently requires num_register_tokens=0."
            )

        if backbone.config.patch_drop_rate != 0.0:
            raise ValueError(
                "FM-Bench ViTMAE performs masking inside the MAE method. "
                "Construct ViT3D with patch_drop_rate=0.0."
            )

        embed_dim = backbone.config.embed_dim

        self.mask_token = nn.Parameter(
            torch.zeros(1, 1, embed_dim)
        )

        self.decoder = Eva(
            embed_dim=embed_dim,
            depth=self.config.decoder_depth,
            num_heads=self.config.decoder_num_heads,
            ref_feat_shape=backbone.feature_shape,
            num_reg_tokens=0,
            use_rot_pos_emb=backbone.config.use_rot_pos_emb,
            use_abs_pos_emb=backbone.config.use_abs_pos_emb,
            mlp_ratio=backbone.config.mlp_ratio,
            drop_path_rate=0.0,
            patch_drop_rate=0.0,
            proj_drop_rate=backbone.config.proj_drop_rate,
            attn_drop_rate=backbone.config.attn_drop_rate,
            rope_impl=RotaryEmbeddingCat,
            rope_kwargs=None,
            init_values=backbone.config.init_values,
            scale_attn_inner=backbone.config.scale_attn_inner,
        )

        self.up_projection = PatchDecode(
            patch_size=backbone.patch_size,
            embed_dim=embed_dim,
            out_channels=backbone.config.input_channels,
            norm=LayerNormNd,
            activation=nn.GELU,
        )

        self.up_projection.apply(
            InitWeights_He(1e-2)
        )

        nn.init.normal_(self.mask_token, std=0.02)

        self.loss_fn = MaskedMSELoss()

    @property
    def feature_dim(self) -> int:
        return self.backbone.feature_dim

    def _sample_keep_indices(
        self,
        batch_size: int,
        device: torch.device,
        num_patches: int | None = None,
    ) -> torch.Tensor:
        """Sample visible patch indices using EVA PatchDropout semantics."""

        if num_patches is None:
            num_patches = self.backbone.num_patches

        num_keep = max(
            1,
            int(
                num_patches
                * (1.0 - self.config.mask_ratio)
            ),
        )

        noise = torch.randn(
            batch_size,
            num_patches,
            device=device,
        )

        return torch.argsort(
            noise,
            dim=-1,
        )[:, :num_keep]

    def _encode_visible_tokens(
        self,
        x: torch.Tensor,
        keep_indices: torch.Tensor,
    ) -> torch.Tensor:
        """Patch-embed the image and run only visible tokens through EVA."""

        self.backbone._validate_input(x)

        tokens = self.backbone.down_projection(x)

        tokens = rearrange(
            tokens,
            "b c w h d -> b (h w d) c",
        )

        # Positional embeddings must be constructed for the actual
        # input grid before selecting visible tokens.
        feature_shape = self.backbone._feature_shape_for_input(x)

        pos_embed = self.backbone._absolute_pos_embed(
            feature_shape,
            dtype=tokens.dtype,
            device=tokens.device,
        )

        if pos_embed is not None:
            tokens = tokens + pos_embed

        tokens = self.backbone.eva.pos_drop(tokens)

        rot_pos_embed = self.backbone._rotary_pos_embed(
            feature_shape,
            device=tokens.device,
        )

        embed_dim = tokens.shape[-1]

        gather_index = keep_indices.unsqueeze(-1).expand(
            -1,
            -1,
            embed_dim,
        )

        tokens = tokens.gather(
            1,
            gather_index,
        )

        # Rotary positional embeddings must correspond to the same
        # retained token positions.
        if rot_pos_embed is not None:
            if rot_pos_embed.ndim == 3:
                rope_index = keep_indices.unsqueeze(-1).expand(
                    -1,
                    -1,
                    rot_pos_embed.shape[-1],
                )
                rot_pos_embed = rot_pos_embed.gather(
                    1,
                    rope_index,
                )
            elif rot_pos_embed.ndim == 2:
                # Shared positional table: expand over the batch before
                # selecting each sample's retained positions.
                rot_pos_embed = rot_pos_embed.unsqueeze(0).expand(
                    x.shape[0],
                    -1,
                    -1,
                )

                rope_index = keep_indices.unsqueeze(-1).expand(
                    -1,
                    -1,
                    rot_pos_embed.shape[-1],
                )

                rot_pos_embed = rot_pos_embed.gather(
                    1,
                    rope_index,
                )

        for block in self.backbone.eva.blocks:
            tokens = block(
                tokens,
                rope=rot_pos_embed,
            )

        tokens = self.backbone.eva.norm(tokens)

        return tokens

    def _restore_full_token_sequence(
        self,
        encoded: torch.Tensor,
        keep_indices: torch.Tensor,
        *,
        num_patches: int,
    ) -> torch.Tensor:
        batch_size = encoded.shape[0]
        embed_dim = encoded.shape[-1]

        full_tokens = self.mask_token.expand(
            batch_size,
            num_patches,
            embed_dim,
        ).clone()

        scatter_index = keep_indices.unsqueeze(-1).expand(
            -1,
            -1,
            embed_dim,
        )

        full_tokens.scatter_(
            1,
            scatter_index,
            encoded,
        )

        return full_tokens

    def _voxel_mask_from_keep_indices(
        self,
        keep_indices: torch.Tensor,
        *,
        feature_shape: tuple[int, int, int],
        dtype: torch.dtype,
        device: torch.device,
    ) -> torch.Tensor:
        batch_size = keep_indices.shape[0]
        num_patches = feature_shape[0] * feature_shape[1] * feature_shape[2]

        flat_mask = torch.zeros(
            batch_size,
            num_patches,
            dtype=dtype,
            device=device,
        )

        flat_mask.scatter_(1, keep_indices, 1.0)

        w, h, d = feature_shape

        patch_mask = rearrange(
            flat_mask,
            "b (h w d) -> b 1 w h d",
            h=w,
            w=h,
            d=d,
        )

        pd, ph, pw = self.backbone.patch_size

        patch_mask = patch_mask.repeat_interleave(
            pd,
            dim=2,
        )
        patch_mask = patch_mask.repeat_interleave(
            ph,
            dim=3,
        )
        patch_mask = patch_mask.repeat_interleave(
            pw,
            dim=4,
        )

        return patch_mask

    def _decode_tokens(
        self,
        tokens: torch.Tensor,
        feature_shape: tuple[int, int, int],
    ) -> torch.Tensor:
        """Run the MAE EVA decoder on the actual 3D token grid."""

        # Preserve EVA's original path exactly at the reference resolution.
        if feature_shape == self.backbone.feature_shape:
            decoded, keep_indices = self.decoder(tokens)

            if keep_indices is not None:
                raise RuntimeError(
                    "MAE decoder unexpectedly dropped tokens."
                )

            return decoded

        # Dynamic absolute positional embedding.
        pos_embed = self.decoder.pos_embed

        if pos_embed is not None:
            ref_w, ref_h, ref_d = self.backbone.feature_shape
            cur_w, cur_h, cur_d = feature_shape
            embed_dim = pos_embed.shape[-1]

            pos = pos_embed.reshape(
                1,
                ref_h,
                ref_w,
                ref_d,
                embed_dim,
            ).permute(0, 4, 2, 1, 3)

            pos = torch.nn.functional.interpolate(
                pos.float(),
                size=(cur_w, cur_h, cur_d),
                mode="trilinear",
                align_corners=False,
            )

            pos = pos.permute(0, 3, 2, 4, 1).reshape(
                1,
                cur_h * cur_w * cur_d,
                embed_dim,
            )

            tokens = tokens + pos.to(
                device=tokens.device,
                dtype=tokens.dtype,
            )

        tokens = self.decoder.pos_drop(tokens)

        # Dynamic rotary positional embedding.
        rot_pos_embed = None

        if self.decoder.rope is not None:
            if feature_shape == self.backbone.feature_shape:
                rot_pos_embed = self.decoder.rope.get_embed()
            else:
                ref_rope = self.decoder.rope

                dynamic_rope = RotaryEmbeddingCat(
                    dim=ref_rope.dim,
                    feat_shape=feature_shape,
                    ref_feat_shape=self.backbone.feature_shape,
                    temperature=ref_rope.temperature,
                    in_pixels=ref_rope.in_pixels,
                    grid_offset=ref_rope.grid_offset,
                    grid_indexing=ref_rope.grid_indexing,
                )

                rot_pos_embed = dynamic_rope.get_embed().to(
                    device=tokens.device
                )

        for block in self.decoder.blocks:
            tokens = block(
                tokens,
                rope=rot_pos_embed,
            )

        return self.decoder.norm(tokens)

    def reconstruct(
        self,
        x: torch.Tensor,
    ) -> tuple[
        torch.Tensor,
        torch.Tensor,
        torch.Tensor,
    ]:
        feature_shape = self.backbone._feature_shape_for_input(x)
        num_patches = feature_shape[0] * feature_shape[1] * feature_shape[2]

        keep_indices = self._sample_keep_indices(
            batch_size=x.shape[0],
            device=x.device,
            num_patches=num_patches,
        )

        encoded = self._encode_visible_tokens(
            x,
            keep_indices,
        )

        full_tokens = self._restore_full_token_sequence(
            encoded,
            keep_indices,
            num_patches=num_patches,
        )

        decoded = self._decode_tokens(
            full_tokens,
            feature_shape,
        )

        w, h, d = feature_shape

        decoded = rearrange(
            decoded,
            "b (h w d) c -> b c w h d",
            h=w,
            w=h,
            d=d,
        )

        reconstruction = self.up_projection(decoded)

        mask = self._voxel_mask_from_keep_indices(
            keep_indices,
            feature_shape=feature_shape,
            dtype=x.dtype,
            device=x.device,
        )

        return reconstruction, mask, keep_indices

    def compute_loss(
        self,
        x: torch.Tensor,
    ) -> dict[str, torch.Tensor]:
        reconstruction, mask, keep_indices = (
            self.reconstruct(x)
        )

        loss = self.loss_fn(
            reconstruction,
            x,
            mask,
        )

        return {
            "loss": loss,
            "reconstruction": reconstruction,
            "mask": mask,
            "keep_indices": keep_indices,
        }

    def forward(
        self,
        batch: dict[str, torch.Tensor] | torch.Tensor,
    ) -> dict[str, torch.Tensor]:
        if isinstance(batch, torch.Tensor):
            x = batch
        elif isinstance(batch, dict):
            if "data" not in batch:
                raise KeyError(
                    "MAE batch must contain 'data'."
                )
            x = batch["data"]
        else:
            raise TypeError(
                "batch must be a tensor or dictionary."
            )

        return self.compute_loss(x)


# ---------------------------------------------------------------------
# Swin-3D MAE
# ---------------------------------------------------------------------

from fmbench.backbones.swin3d import Swin3D


class SwinMAEDecoder(nn.Module):
    """Lightweight reconstruction decoder for the final Swin3D feature map.

    The decoder mirrors the total spatial downsampling factor of the
    encoder using transposed convolutions. It is used only during MAE
    pretraining and is discarded for downstream backbone evaluation.
    """

    def __init__(
        self,
        in_channels: int,
        out_channels: int,
        num_upsamples: int,
    ) -> None:
        super().__init__()

        if in_channels <= 0:
            raise ValueError("in_channels must be positive.")

        if out_channels <= 0:
            raise ValueError("out_channels must be positive.")

        if num_upsamples <= 0:
            raise ValueError("num_upsamples must be positive.")

        layers: list[nn.Module] = []
        current_channels = in_channels

        for stage in range(num_upsamples):
            is_last = stage == num_upsamples - 1

            if is_last:
                next_channels = out_channels
            else:
                next_channels = max(
                    out_channels,
                    current_channels // 2,
                )

            layers.append(
                nn.ConvTranspose3d(
                    current_channels,
                    next_channels,
                    kernel_size=2,
                    stride=2,
                )
            )

            if not is_last:
                layers.append(
                    nn.InstanceNorm3d(
                        next_channels,
                        eps=1e-5,
                        affine=True,
                    )
                )
                layers.append(
                    nn.GELU()
                )

            current_channels = next_channels

        self.decode = nn.Sequential(*layers)

    def forward(
        self,
        x: torch.Tensor,
    ) -> torch.Tensor:
        return self.decode(x)


class SwinMAE(nn.Module):
    """Masked reconstruction method for the Swin3D backbone.

    Masking is owned by the SSL method rather than the backbone:

        image
          -> block mask
          -> zero masked voxels
          -> Swin3D encoder
          -> reconstruction decoder
          -> masked-region MSE

    The Swin encoder itself is therefore identical between pretraining
    and downstream use.
    """

    def __init__(
        self,
        backbone: Swin3D,
        config: MAEConfig | None = None,
    ) -> None:
        super().__init__()

        if not isinstance(backbone, Swin3D):
            raise TypeError(
                "SwinMAE requires a Swin3D backbone."
            )

        self.backbone = backbone
        self.config = config or MAEConfig()

        factors = tuple(
            int(v)
            for v in backbone.downsample_factor
        )

        # Current Swin3D uses isotropic powers-of-two downsampling.
        # Keep this explicit rather than silently constructing an
        # incorrect decoder for a future anisotropic configuration.
        if len(set(factors)) != 1:
            raise ValueError(
                "SwinMAE currently requires an isotropic total "
                f"downsampling factor, got {factors}."
            )

        factor = factors[0]

        if factor <= 0 or factor & (factor - 1):
            raise ValueError(
                "SwinMAE requires a power-of-two total "
                f"downsampling factor, got {factor}."
            )

        num_upsamples = factor.bit_length() - 1

        self.decoder = SwinMAEDecoder(
            in_channels=backbone.feature_dim,
            out_channels=backbone.config.input_channels,
            num_upsamples=num_upsamples,
        )

        self.loss_fn = MaskedMSELoss()

    @property
    def feature_dim(self) -> int:
        return self.backbone.feature_dim

    def create_mask(
        self,
        x: torch.Tensor,
    ) -> torch.Tensor:
        """Create a block-wise voxel mask for the input volume."""

        spatial_shape = tuple(
            int(v)
            for v in x.shape[2:]
        )

        return create_voxel_mask(
            batch_size=x.shape[0],
            spatial_shape=spatial_shape,
            block_size=self.config.mask_block_size,
            mask_ratio=self.config.mask_ratio,
            device=x.device,
        ).to(dtype=x.dtype)

    def reconstruct(
        self,
        x: torch.Tensor,
        mask: torch.Tensor | None = None,
    ) -> tuple[torch.Tensor, torch.Tensor]:
        self.backbone._validate_input(x)

        if mask is None:
            mask = self.create_mask(x)

        if mask.shape != x.shape:
            if (
                mask.ndim == x.ndim
                and mask.shape[0] == x.shape[0]
                and mask.shape[1] == 1
                and mask.shape[2:] == x.shape[2:]
            ):
                mask = mask.expand_as(x)
            else:
                raise ValueError(
                    "Mask must have the same shape as the input, "
                    "or a singleton channel dimension. "
                    f"Got x={tuple(x.shape)}, "
                    f"mask={tuple(mask.shape)}."
                )

        masked_x = x * mask

        features = self.backbone.forward_features(
            masked_x
        )

        reconstruction = self.decoder(
            features
        )

        if reconstruction.shape != x.shape:
            raise RuntimeError(
                "SwinMAE decoder produced an unexpected "
                f"shape {tuple(reconstruction.shape)}; "
                f"expected {tuple(x.shape)}."
            )

        return reconstruction, mask

    def compute_loss(
        self,
        x: torch.Tensor,
    ) -> dict[str, torch.Tensor]:
        reconstruction, mask = self.reconstruct(x)

        loss = self.loss_fn(
            reconstruction,
            x,
            mask,
        )

        return {
            "loss": loss,
            "reconstruction": reconstruction,
            "mask": mask,
        }

    def forward(
        self,
        batch: dict[str, torch.Tensor] | torch.Tensor,
    ) -> dict[str, torch.Tensor]:
        if isinstance(batch, torch.Tensor):
            x = batch
        elif isinstance(batch, dict):
            if "data" not in batch:
                raise KeyError(
                    "MAE batch must contain 'data'."
                )
            x = batch["data"]
        else:
            raise TypeError(
                "batch must be a tensor or dictionary."
            )

        return self.compute_loss(x)
